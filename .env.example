# Copy this file to .env and fill in your real values.
# Gmail: enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=Streamly Cinema <your-address@gmail.com>

# Set this to your deployed HTTPS website URL for links in emails.
# Example: https://your-streamly-site.onrender.com
# For local development leave blank.
PUBLIC_BASE_URL=
PORT=3000
